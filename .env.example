# ==============================================================================
# Lecture Document Generator - Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Model to use (Options: gemini-3.5-flash, gemini-3.6-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash

# 3. Maximum number of PDF inputs allowed per run (Default: 5)
MAX_PDF_LIMIT=5

# 4. Optional: OCR resolution scale (Default: 2 for crisp 2x resolution)
OCR_SCALE=2

# 5. Output directory for generated documents (Relative or absolute path)
OUTPUT_DIR=output
