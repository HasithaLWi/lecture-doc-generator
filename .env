# ==============================================================================
# Lecture Document Generator - Environment Configuration
# ==============================================================================

# Paste your Gemini API key below (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model name (gemini-3.5-flash provides deep, textbook-grade lecture notes)
GEMINI_MODEL=gemini-3.1-flash-lite

# Maximum number of PDF inputs allowed per run
MAX_PDF_LIMIT=5

# OCR resolution scale
OCR_SCALE=2.0

# Output directory
OUTPUT_DIR=F:\IJSE\THIRED SEM\PYTHON\python_note\lecture_doc_generator\output
COURSE_HEADER=Comprehensive Lecture Study Guide 
